    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Fernuni Bot",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/fernuni_bot.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/docker.env"
        },
        {
            "name": "Python Debugger: Scraper",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/module_scraper.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/docker.env"
        },
        {
            "name": "Python Debugger: GradeStatisticsScraper Scraper",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/grade_statistics_scraper.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/docker.env"
        },
        {
            "name": "Python Debugger: GradeStatisticsScraper Plotter",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/grade_statistics_plotter.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/docker.env"
        }                  
    ]
}